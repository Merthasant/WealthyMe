generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum roles {
  admin
  user
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  createdAt     Int            @default(0)
  updatedAt     Int            @default(0)
  role          role? // for 1-1 relation
  refreshTokens refreshToken[]
  profile       profile?
  accounts      account[]
  categories    category[]

  @@index([name])
  @@index([updatedAt])
}

// mungkin table role akan dihapus, jika ya makan user akan menambah column role
model role {
  id        String @id @default(uuid())
  name      roles  @default(user)
  userId    String @unique // for 1-1 relation
  user      user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt Int    @default(0)
  updatedAt Int    @default(0)
}

// for scalable

model refreshToken {
  id        String  @id @default(uuid())
  token     String  @unique
  isRevoked Boolean @default(false)
  expiredAt Int
  device    String
  userId    String
  user      user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt Int     @default(0)
  updatedAt Int     @default(0)

  @@index([isRevoked])
  @@index([userId])
}

model profile {
  id             String  @id @default(uuid())
  displayName    String? @unique
  birthDate      Int?
  profession     String?
  avatarUrl      String?
  avatarPublicId String?
  timezone       String
  userId         String  @unique
  user           user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      Int     @default(0)
  updatedAt      Int     @default(0)
}

enum walletType {
  cash
  e_wallet
  bank
  investment
}

enum currencyType {
  IDR
  USD
  SGD
  EUR
}

model account {
  id            String       @id @default(uuid())
  name          String
  type          walletType   @default(cash)
  // nanti column balance akan di hapus
  balance       Decimal      @db.Decimal(15, 2)
  currency_code currencyType
  userId        String
  user          user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    Int           @default(0)
  updatedAt    Int           @default(0)
  transactions transaction[]

  @@index([name])
  @@index([type])
  @@index([updatedAt])
  @@index([userId])
}

enum transactionType {
  // type transfer akan bertambah
  income
  expense
}

model category {
  id           String          @id @default(uuid())
  name         String
  type         transactionType
  userId       String?
  user         user?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    Int             @default(0)
  updatedAt    Int             @default(0)
  transactions transaction[]

  @@index([userId])
  @@index([type])
  @@index([name])
  @@index([updatedAt])
}

model transaction {
  id              String          @id @default(uuid())
  // amount akan jadi type bigint, usd,sgd,eur mungkin akan menjadi satuan terkecil tanpa coma
  amount          Decimal         @db.Decimal(15, 2)
  // column amount in idr akan ada untuk sorting
  type            transactionType
  note            String?
  // column transferId akan
  // column typeTransfer in/out akan ada juga
  // column fee transfer
  transactionAt   Int
  deletedAt       Int?
  receiptUrl      String?
  receiptPublicId String?
  currency_code   currencyType
  accountId       String
  account         account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId      String
  category        category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       Int             @default(0)
  updatedAt       Int             @default(0)

  @@index([updatedAt])
  @@index([categoryId])
  @@index([accountId])
  @@index([transactionAt])
  @@index([type])
  @@index([deletedAt])
}

// akan menambah table budget 1-1 ke category (mungkin) dan table tagging
