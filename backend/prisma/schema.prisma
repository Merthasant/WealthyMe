generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum roles {
  admin
  user

  @@map("roles")
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          roles          @default(user)
  createdAt     BigInt         @default(0) @map("created_at")
  updatedAt     BigInt         @default(0) @map("updated_at")
  refreshTokens RefreshToken[]
  profile       Profile?
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  tags          Tag[]

  @@map("user")
}

// for scalable

model RefreshToken {
  id        String  @id @default(uuid())
  tokenHash String  @unique @map("token_hash")
  isRevoked Boolean @default(false) @map("is_revoked")
  expiredAt BigInt  @map("expired_at")
  device    String
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt BigInt  @default(0) @map("created_at")
  updatedAt BigInt  @default(0) @map("updated_at")

  @@index([userId])
  @@map("refresh_token")
}

model Profile {
  id             String  @id @default(uuid())
  displayName    String? @map("display_name")
  birthDate      BigInt? @map("birth_date")
  profession     String?
  avatarUrl      String? @map("avatar_url")
  avatarPublicId String? @map("avatar_public_id")
  timezone       String
  userId         String  @unique @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt BigInt @default(0) @map("created_at")
  updatedAt BigInt @default(0) @map("updated_at")

  @@index([userId])
  @@map("profile")
}

enum walletType {
  cash
  e_wallet
  bank
  investment

  @@map("wallet_type")
}

enum currencyType {
  IDR
  USD
  SGD
  EUR

  @@map("currency_type")
}

model Account {
  id             String       @id @default(uuid())
  name           String
  type           walletType   @default(cash)
  initialBalance BigInt       @default(0) @map("initial_balance") // makek bigInt karena aku ingin usd atapun yang lain memakai satuan terkecilnya
  currencyCode   currencyType @map("currency_code")
  userId         String       @map("user_id")
  colorName      String       @map("color_name")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt BigInt @default(0) @map("created_at")
  updatedAt BigInt @default(0) @map("updated_at")

  transactions Transaction[]

  @@index([userId, name])
  @@map("account")
}

enum transactionType {
  income
  expense
  transfer_in
  transfer_out

  @@map("transaction_type")
}

enum categoryType {
  income
  expense

  @@map("category_type")
}

model Category {
  id        String       @id @default(uuid())
  name      String
  iconName  String       @map("icon_name")
  colorName String       @map("color_name")
  type      categoryType
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    BigInt        @default(0) @map("created_at")
  updatedAt    BigInt        @default(0) @map("updated_at")
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@map("category")
}

model Transaction {
  id                String          @id @default(uuid())
  amount            BigInt          @default(0) // makek bigInt karena aku ingin usd atapun yang lain memakai satuan terkecilnya
  amountInIdr       BigInt          @default(0) @map("amount_in_idr")
  type              transactionType
  note              String?
  pairTransactionId String?         @unique @map("pair_transaction_id")
  transactionAt     BigInt          @map("transaction_at")
  deletedAt         BigInt?         @map("deleted_at")
  receiptUrl        String?         @map("receipt_url")
  receiptPublicId   String?         @map("receipt_public_id")
  currencyCode      currencyType    @map("currency_code")
  userId            String          @map("user_id")
  accountId         String          @map("account_id")
  categoryId        String?         @map("category_id")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pairTransaction Transaction? @relation("transferPair", fields: [pairTransactionId], references: [id])
  pairedBy        Transaction? @relation("transferPair")

  createdAt       BigInt           @default(0) @map("created_at")
  updatedAt       BigInt           @default(0) @map("updated_at")
  transactionTags TransactionTag[]

  @@index([userId, amountInIdr])
  @@index([userId, transactionAt])
  @@index([userId, categoryId])
  @@map("transaction")
}

model Budget {
  id          String  @id @default(uuid())
  name        String
  note        String?
  colorName   String  @map("color_name")
  startAt     BigInt  @map("start_at")
  endAt       BigInt  @map("end_at")
  limitAmount BigInt  @map("limit_amount")
  userId      String  @map("user_id")
  categoryId  String  @map("category_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt BigInt @default(0) @map("created_at")
  updatedAt BigInt @default(0) @map("updated_at")

  @@index([userId, name])
  @@index([userId, startAt, endAt])
  @@index([userId, categoryId])
  @@map("budget")
}

model Tag {
  id        String @id @default(uuid())
  name      String
  colorName String @map("color_name")
  userId    String @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       BigInt           @default(0) @map("created_at")
  updatedAt       BigInt           @default(0) @map("updated_at")
  transactionTags TransactionTag[]

  @@unique([userId, name])
  @@map("tag")
}

model TransactionTag {
  transactionId String @map("transaction_id")
  tagId         String @map("tag_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([transactionId, tagId])
  @@map("transaction_tag")
}
